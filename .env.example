# Configuration TTS API
# Copiez ce fichier en .env et modifiez selon vos besoins

# Ports
API_PORT=5002
GRADIO_PORT=7860

# Langue par défaut
DEFAULT_LANGUAGE=fr

# Paramètres TTS par défaut
DEFAULT_TEMPERATURE=0.75
DEFAULT_SPEED=1.0

# Device (cuda ou cpu)
# Laissez vide pour détection automatique
DEVICE=

# Chemin vers les échantillons de voix (optionnel)
# Si vide, utilise data/voices/ par défaut
VOICES_DIR=

# Chemin de sortie (optionnel)
# Si vide, utilise data/outputs/ par défaut
OUTPUTS_DIR=
